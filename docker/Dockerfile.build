# Self-contained build: compiles frontend then assembles the production image.
# Usage: docker build -f docker/Dockerfile.build -t d3v-server-manager .

# ── Stage 1: Build frontend ──────────────────────────────────────────────────
FROM node:20-bookworm-slim AS frontend-build

WORKDIR /build/frontend
COPY frontend/package.json frontend/yarn.lock* ./
RUN yarn install --frozen-lockfile 2>/dev/null || yarn install

COPY frontend/ ./
RUN yarn locale-compile && yarn build

# ── Stage 2: Test CA certificate ─────────────────────────────────────────────
FROM nginxproxymanager/testca AS testca

# ── Stage 3: Production image ────────────────────────────────────────────────
FROM nginxproxymanager/nginx-full:certbot-node

ARG TARGETPLATFORM
ARG BUILD_VERSION
ARG BUILD_COMMIT
ARG BUILD_DATE

ENV SUPPRESS_NO_CONFIG_WARNING=1 \
	S6_BEHAVIOUR_IF_STAGE2_FAILS=1 \
	S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0 \
	S6_FIX_ATTRS_HIDDEN=1 \
	S6_KILL_FINISH_MAXTIME=10000 \
	S6_VERBOSITY=1 \
	NODE_ENV=production \
	D3V_BUILD_VERSION="${BUILD_VERSION}" \
	D3V_BUILD_COMMIT="${BUILD_COMMIT}" \
	D3V_BUILD_DATE="${BUILD_DATE}" \
	NODE_OPTIONS="--openssl-legacy-provider"

RUN echo "fs.file-max = 65535" > /etc/sysctl.conf \
	&& apt-get update \
	&& apt-get install -y --no-install-recommends jq logrotate wireguard-tools iptables iproute2 \
	&& apt-get clean \
	&& rm -rf /var/lib/apt/lists/*

# s6 overlay
COPY docker/scripts/install-s6 /tmp/install-s6
RUN /tmp/install-s6 "${TARGETPLATFORM}" && rm -f /tmp/install-s6

EXPOSE 80 81 443 51820/udp

# Backend
COPY backend /app
# Frontend (built in stage 1)
COPY --from=frontend-build /build/frontend/dist /app/frontend

WORKDIR /app
RUN yarn install --production \
	&& yarn cache clean

# rootfs (s6 services, nginx config, etc.)
COPY docker/rootfs /
COPY --from=testca /home/step/certs/root_ca.crt /etc/ssl/certs/D3VServerManager.crt

RUN rm -rf /etc/s6-overlay/s6-rc.d/user/contents.d/frontend /etc/nginx/conf.d/dev.conf \
	&& chmod 644 /etc/logrotate.d/d3v-server-manager

VOLUME [ "/data", "/etc/wireguard" ]
ENTRYPOINT [ "/init" ]

LABEL org.label-schema.schema-version="1.0" \
	org.label-schema.license="MIT" \
	org.label-schema.name="d3v-server-manager" \
	org.label-schema.description="D3V Server Manager - Nginx proxy, SSL, and WireGuard VPN management" \
	org.label-schema.url="https://github.com/xtcnet/D3V-Server-Manager" \
	org.label-schema.vcs-url="https://github.com/xtcnet/D3V-Server-Manager.git"
